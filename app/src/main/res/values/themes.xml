<resources>
    <style name="Theme.MyLuggagePartner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MyLuggagePartner.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FBFAF7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyLuggagePartner</item>
    </style>
</resources>
